rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 🔒 1. USER PRIVATE DATA ISOLATION (Words, Sets, Progress, Speaking & Writing Portfolios)
    // ONLY the authenticated owner can read or write their own documents & subcollections.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 📖 2. PUBLIC SHARED IELTS DICTIONARY & CORPUS (Read-only for users)
    match /ielts_word_bundles/{bundleId} {
      allow read: if true;
      allow write: if false;
    }

    match /ielts_words/{wordId} {
      allow read: if true;
      allow write: if false;
    }

    match /ielts_sets/{setId} {
      allow read: if true;
      allow write: if false;
    }

    match /ielts_meta/{metaId} {
      allow read: if true;
      allow write: if false;
    }

    // ⚡ 3. AI RESPONSES CACHE
    match /ielts_ai_cache/{cacheId} {
      allow read, write: if true;
    }

    // Default deny all other unspecified routes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
